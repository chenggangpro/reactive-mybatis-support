<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pro.chenggang.project.reactive.mybatis.support.r2dbc.execution.procedure.PostgresqlNoticeMapper">

  <select id="callWithNoticeAndReturnValue" resultType="java.lang.String">
    SELECT noticeWithReturn()
  </select>

  <select id="callWithNoticeOnly">
    DO language plpgsql $$
    BEGIN
      RAISE NOTICE 'This';
      RAISE NOTICE 'is';
      RAISE NOTICE 'notice';
      RAISE NOTICE 'in';
      RAISE NOTICE 'multiple';
      RAISE NOTICE 'lines';
    END
    $$;
  </select>

</mapper>